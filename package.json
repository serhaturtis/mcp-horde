{
  "name": "mcp-horde",
  "private": true,
  "description": "A horde of MCP servers for agentic coding.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @mcp-horde/core && npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15"
  },
  "engines": {
    "node": ">=20"
  }
}
