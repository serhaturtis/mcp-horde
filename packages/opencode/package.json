{
  "name": "@mcp-horde/opencode",
  "version": "0.2.0",
  "private": true,
  "description": "MCP server that lets any harness delegate work to OpenCode agents on any model: spawn them in parallel, steer, wait, pause, resume, and answer their permission prompts.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "opencode",
    "agents",
    "subagents",
    "claude-code",
    "deepseek"
  ],
  "type": "module",
  "bin": {
    "mcp-horde-opencode": "dist/index.js"
  },
  "exports": {
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhaturtis/mcp-horde.git",
    "directory": "packages/opencode"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --conditions=source --import tsx --test --test-concurrency=1 test/unit.test.ts test/core.test.ts test/modes.test.ts test/flow.test.ts test/dist.test.ts test/plugin.test.ts test/fleet-fixes.test.ts",
    "test:unit": "node --conditions=source --import tsx --test test/unit.test.ts",
    "test:e2e": "node --conditions=source --import tsx --test test/e2e.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@mcp-horde/board": "^0.1.0",
    "@mcp-horde/context": "^0.1.0",
    "@mcp-horde/core": "^0.1.0",
    "@mcp-horde/review": "^0.1.0",
    "@mcp-horde/verify": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@opencode-ai/sdk": "1.19.3",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "opencode-ai": "1.19.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
