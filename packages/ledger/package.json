{
  "name": "@mcp-horde/ledger",
  "version": "0.1.0",
  "private": true,
  "description": "Learns which worker model to start a task on from the board's history: pass rates, gate rounds, escalations and cost per accepted task by model, tier, area and kind of work, and a starting-tier suggestion for new tasks.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agents",
    "orchestration",
    "model-routing",
    "claude-code",
    "opencode"
  ],
  "type": "module",
  "bin": {
    "mcp-horde-ledger": "dist/index.js"
  },
  "exports": {
    ".": {
      "source": "./src/lib.ts",
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhaturtis/mcp-horde.git",
    "directory": "packages/ledger"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --conditions=source --import tsx --import ../../scripts/test-env.mjs --test --test-concurrency=1 test/ledger.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@mcp-horde/board": "^0.1.0",
    "@mcp-horde/core": "^0.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
