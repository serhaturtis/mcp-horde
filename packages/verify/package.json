{
  "name": "@mcp-horde/verify",
  "version": "0.1.0",
  "private": true,
  "description": "MCP server that judges work mechanically: runs a project's tests, typecheck and lint, audits a diff for scope violations and test tampering, and returns a compact verdict.",
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "verification",
    "tests",
    "agents",
    "claude-code"
  ],
  "type": "module",
  "bin": {
    "mcp-horde-verify": "dist/index.js"
  },
  "exports": {
    ".": {
      "source": "./src/lib.ts",
      "types": "./dist/lib.d.ts",
      "default": "./dist/lib.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhaturtis/mcp-horde.git",
    "directory": "packages/verify"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "node --conditions=source --import tsx --import ../../scripts/test-env.mjs --test --test-concurrency=1 test/extract.test.ts test/verify.test.ts",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@mcp-horde/context": "^0.1.0",
    "@mcp-horde/core": "^0.1.0",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=20"
  }
}
